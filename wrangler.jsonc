{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaproxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5e00a1be-691f-4af7-8e17-f2bf9ebacd18","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c9aabe27ca024b85b1ff69349694f60e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
